# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/

*.egg-info/
dist/
build/
.pytest_cache/
.coverage
htmlcov/

# Superpowers brainstorm / specs (local only)
# docs/ is local-only by default. The project-management files listed below are the
# only ones tracked; anything else in docs/projectmanagement/ stays local until listed.
docs/*
!docs/projectmanagement/
docs/projectmanagement/*
!docs/projectmanagement/Architecture.md
!docs/projectmanagement/BACKLOG.md
!docs/projectmanagement/BOARD.md
!docs/projectmanagement/Dependencies.md
!docs/projectmanagement/GameConcept.md
!docs/projectmanagement/GLOSSARY.md
!docs/projectmanagement/PIPELINE.md
!docs/projectmanagement/POSTMORTEMS.md
!docs/projectmanagement/PROCESS.md
!docs/projectmanagement/ProjectChecklist.md
!docs/projectmanagement/ProjectManagement.md
!docs/projectmanagement/release.md
!docs/projectmanagement/RISKS.md
!docs/projectmanagement/RUNBOOK.md
.superpowers/


# Game saves (runtime, not committed)
saves/*
!saves/.gitkeep

# User settings (per-user customization — see settings.example.json)
settings.json

# Local MCP server config
.mcp.json

# Stories excluded from gen release (local backup only)
storybackup/

# Playwright screenshots / test artifacts (local only)
_playwright_artifacts/
.playwright-mcp/

# Example and showcase stubs (work in progress, not yet published)
stories/examples/
stories/showcase/

# Social media drafts (local only)
sm_post.md

# Git worktrees (local only)
.worktrees/

# Obsidian vault metadata
.obsidian/

# Notion export artifacts
notion_export/
*.notion/
